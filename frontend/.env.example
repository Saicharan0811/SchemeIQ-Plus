# SchemeIQ+ Frontend Environment Configuration Example
# Copy this file to .env and configure VITE_API_BASE_URL for your environment.
#
# IMPORTANT — Vercel deployment:
#   Do NOT set this variable in a committed .env file.
#   Instead, set VITE_API_BASE_URL in the Vercel Project Settings →
#   Settings → Environment Variables (Production environment).
#
#   The value MUST be the publicly accessible HTTPS URL of your Flask backend.
#   Example: https://your-flask-api.onrender.com
#
#   The Flask backend MUST be deployed and reachable over HTTPS from the internet.
#   A locally running Flask server on 127.0.0.1:5000 is NOT reachable from Vercel.

# ──────────────────────────────────────────────────────────────────────────────
# Local Development — uncomment and use the line below:
# ──────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://127.0.0.1:5000

# ──────────────────────────────────────────────────────────────────────────────
# Production (set this in the Vercel dashboard, NOT here):
# ──────────────────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=https://your-flask-api.onrender.com
