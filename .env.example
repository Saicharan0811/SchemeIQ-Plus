# ==============================================================================
# SchemeIQ+ Production & Deployment Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Update values for your deployment environment.
# 3. NEVER commit secrets, API keys, or private credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Environment Settings
# ------------------------------------------------------------------------------
APP_NAME=SchemeIQ-Plus

# Set to 'production' to strictly enforce disabled debug/testing modes and harden security headers.
# Options: production | development
FLASK_ENV=production
ENVIRONMENT=production

# Logging level. Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Application Secret Key. In production, generate a cryptographically strong random string:
# python -c "import secrets; print(secrets.token_hex(32))"
# If empty in production, a dynamic runtime secret is generated.
SECRET_KEY=

# ------------------------------------------------------------------------------
# 2. Production Server & Network Settings (WSGI / Waitress / Gunicorn)
# ------------------------------------------------------------------------------
# Host interface to bind to (0.0.0.0 binds to all interfaces, 127.0.0.1 for localhost only)
HOST=0.0.0.0

# Port for the REST API service
PORT=5000

# Number of worker threads for Waitress WSGI server
WSGI_THREADS=4

# ------------------------------------------------------------------------------
# 3. CORS & Origin Security Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of trusted frontend origins permitted to access this API.
# In local development: http://localhost:5173,http://127.0.0.1:5173
# In production: https://app.schemeiq.example.com,https://schemeiq.gov.in
# Set to '*' only if wildcard access across any domain is explicitly intended.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Data & Document Corpus Paths
# ------------------------------------------------------------------------------
DATA_DIR=data
DOCUMENTS_DIR=data/documents
SCHEMES_CSV_PATH=data/schemes.csv

# ------------------------------------------------------------------------------
# 5. Language Support (ISO 639-1)
# ------------------------------------------------------------------------------
SUPPORTED_LANGUAGES=en,te
DEFAULT_LANGUAGE=en

# ------------------------------------------------------------------------------
# 6. RAG & Embedding Model Configuration
# ------------------------------------------------------------------------------
# Embedding model provider: sentence-transformers (local, offline-capable, default)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Optional LLM generation provider.
# Options: (empty = built-in grounded template fallback, zero external calls) | openai
LLM_PROVIDER=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# OpenAI API key — only required if LLM_PROVIDER=openai
# Never commit real API keys to repository or version control.
OPENAI_API_KEY=
